                <h1 className="text-5xl font-black tracking-tighter text-white italic mb-4">FOUND.</h1>
                <p className="text-slate-400 text-center text-lg font-medium max-w-[280px] leading-relaxed mb-16">Mutual interest before effort.</p>
                <button onClick={() => setStep('auth')} className="w-full bg-white text-black py-5 rounded-2xl font-black text-lg active:scale-95 transition-all">Begin Journey</button>
             </div>
          )}

          {step === 'auth' && (
            <div className={`min-h-full ${THEME.neutral.bg} p-10 flex flex-col pt-24 animate-in slide-in-from-right-10`}>
                <h2 className="text-4xl font-black text-white italic tracking-tighter mb-12">Identify Yourself.</h2>
                <div className="space-y-4">
                    <input type="email" placeholder="Work Email" className={`${THEME.neutral.card} w-full py-5 px-6 rounded-2xl border border-slate-800 text-white font-bold outline-none`} />
                    <button onClick={() => setStep('role-selection')} className="w-full bg-white text-black py-5 rounded-2xl font-black text-lg shadow-xl active:scale-95 transition-all">Continue</button>
                </div>
            </div>
          )}

          {step === 'role-selection' && (
            <div className={`min-h-full ${THEME.neutral.bg} p-10 flex flex-col justify-center animate-in slide-in-from-bottom-10`}>
              <h2 className="text-4xl font-black text-white italic tracking-tighter mb-4">Choose Path.</h2>
              <div className="space-y-4">
                {['founder', 'investor'].map(r => (
                  <button key={r} onClick={() => { setRole(r); setStep(r === 'founder' ? 'founder-setup' : 'investor-setup'); }} className={`${THEME.neutral.card} w-full p-8 rounded-[35px] border border-slate-800 text-left hover:border-indigo-500 transition-all group active:scale-95`}>
                    <p className="text-2xl font-black text-white italic uppercase tracking-tighter">{r}</p>
                    <p className="text-slate-500 font-bold uppercase tracking-widest text-[9px] mt-1">{r === 'founder' ? 'Seeking strategic alignment' : 'Optimizing for high signal'}</p>
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* 1. PROFILE SETUP (FOUNDER) */}
          {step === 'founder-setup' && (
            <div className={`min-h-full ${THEME.neutral.bg} p-8 pt-20 animate-in slide-in-from-right-10`}>
                <h2 className="text-3xl font-black text-white italic tracking-tighter mb-2">The Snapshot.</h2>
                <p className="text-slate-500 text-sm mb-8">Structured fields only. No decks. No selling.</p>
                
                <div className="space-y-5">
                    {[
                      { label: 'Sector', placeholder: 'e.g. Health AI' },
                      { label: 'Problem (1 sentence)', placeholder: 'What is broken?' },
                      { label: 'The Idea (1 sentence)', placeholder: 'How are you fixing it?' },
                      { label: 'Proof (1 sentence)', placeholder: 'Why does this work?' },
                      { label: 'Team (1 sentence)', placeholder: 'Who is building this?' }
                    ].map((field, i) => (
                      <div key={i}>
                        <label className="text-[10px] font-bold text-indigo-400 uppercase tracking-widest ml-2 mb-2 block">{field.label}</label>
                        <input type="text" placeholder={field.placeholder} className={`${THEME.neutral.card} w-full p-4 rounded-2xl border border-slate-800 text-white font-medium outline-none focus:border-indigo-500 text-sm`} />
                      </div>
                    ))}
                </div>
                <button onClick={() => { setActiveTab('discovery'); setStep('feed'); }} className="w-full bg-indigo-500 text-white py-5 rounded-2xl font-black text-lg mt-8 active:scale-95 transition-all">Submit Profile</button>
            </div>
          )}

          {/* 0. INVESTOR ONBOARDING & VETTING */}
          {step === 'investor-setup' && (
            <div className={`min-h-full ${THEME.neutral.bg} p-8 pt-20 animate-in slide-in-from-right-10`}>
                <h2 className="text-3xl font-black text-white italic tracking-tighter mb-2">Verification.</h2>
                <p className="text-slate-500 text-sm mb-8">Keep it minimal. Credibility first.</p>
                
                <div className="space-y-5">
                    {[
                      { label: 'Firm / Affiliation', placeholder: 'e.g. Angel, Nexus Labs' },
                      { label: 'Investing Stage', placeholder: 'e.g. Pre-seed / Seed' },
                      { label: 'Ticket Size Range', placeholder: 'e.g. $250k - $500k' },
                      { label: 'Sectors', placeholder: 'e.g. DevTools, Fintech' },
                      { label: 'Geography', placeholder: 'e.g. Global, SF, London' }
                    ].map((field, i) => (
                      <div key={i}>
                        <label className="text-[10px] font-bold text-emerald-400 uppercase tracking-widest ml-2 mb-2 block">{field.label}</label>
                        <input type="text" placeholder={field.placeholder} className={`${THEME.neutral.card} w-full p-4 rounded-2xl border border-slate-800 text-white font-medium outline-none focus:border-emerald-500 text-sm`} />
                      </div>
                    ))}
                </div>
                <button onClick={() => setStep('pending-verification')} className="w-full bg-emerald-500 text-white py-5 rounded-2xl font-black text-lg mt-8 active:scale-95 transition-all">Submit for Review</button>
            </div>
          )}

          {step === 'pending-verification' && (
            <div className={`min-h-full ${THEME.neutral.bg} flex flex-col items-center justify-center p-10 text-center animate-in zoom-in-95`}>
               <div className="w-24 h-24 bg-slate-900 rounded-full flex items-center justify-center mb-8 border border-slate-800">
                  <ShieldCheck size={40} className="text-slate-500" />
               </div>
               <h2 className="text-3xl font-black text-white italic tracking-tighter mb-4">Pending Verification.</h2>
               <p className="text-slate-500 mb-12">We are reviewing your profile. To maintain high signal, discovery is blocked until approval.</p>
               
               {/* Hidden developer button for demo progression */}
               <button onClick={() => { setActiveTab('discovery'); setStep('feed'); }} className="text-xs font-bold text-slate-700 underline underline-offset-4">Developer: Simulate Approval</button>
            </div>
          )}

          {/* HOME DASHBOARD */}
          {step === 'home' && (
            <div className={`min-h-full ${THEME.neutral.bg} pt-24 px-8 flex flex-col animate-in fade-in`}>
              <div className="flex justify-between items-center mb-10">
                <div>
                  <h2 className="text-4xl font-black text-white italic tracking-tighter">Overview.</h2>
                  <p className="text-slate-500 font-bold text-xs uppercase tracking-widest mt-1">Welcome back</p>
                </div>
                <div className={`w-14 h-14 ${roleTheme.primary} rounded-2xl flex items-center justify-center text-white text-2xl font-black italic shadow-lg`}>
                  {role === 'founder' ? 'F' : 'I'}
                </div>
              </div>

              <div className="space-y-6">
                {/* AI-Curated Picks Section (10 in PDF) */}
                <div className={`${THEME.neutral.card} p-8 rounded-[35px] border ${THEME.neutral.border} shadow-xl relative overflow-hidden`}>
                   <div className={`absolute top-0 left-0 w-full h-1 ${roleTheme.primary}`} />
                   <h3 className="text-white font-black text-2xl italic mb-3 flex items-center gap-2"><Zap size={24} className={roleTheme.text}/> Curated Queue</h3>
                   <p className="text-slate-400 text-sm leading-relaxed mb-8">Top aligned {role === 'founder' ? 'investors' : 'founders'} this week based on sector and ticket fit.</p>
                   <button onClick={() => { setActiveTab('discovery'); setStep('feed'); }} className={`w-full py-5 rounded-2xl ${roleTheme.primary} text-white font-black text-lg active:scale-95 transition-all shadow-lg flex items-center justify-center gap-2`}>
                     Enter Discovery <ArrowRight size={20} />
                   </button>
                </div>

                <div className="grid grid-cols-2 gap-4">
                   <button onClick={() => { setActiveTab('calls'); setStep('calls'); }} className={`${THEME.neutral.card} p-6 rounded-[35px] border ${THEME.neutral.border} flex flex-col justify-between h-36 active:scale-95 transition-all text-left`}>
                     <Activity size={24} className={hasMatches ? roleTheme.text : 'text-slate-500'} />
                     <div>
                       <p className="text-white font-black text-3xl">{hasMatches ? '1' : '0'}</p>
                       <p className="text-slate-500 font-bold text-[10px] uppercase tracking-widest mt-1">Active Loops</p>
                     </div>
                   </button>
                   <button onClick={() => { setActiveTab('profile'); setStep('profile'); }} className={`${THEME.neutral.card} p-6 rounded-[35px] border ${THEME.neutral.border} flex flex-col justify-between h-36 active:scale-95 transition-all text-left`}>
                     <HistoryIcon size={24} className="text-slate-500" />
                     <div>
                       <p className="text-white font-black text-3xl">{callHistory.length}</p>
                       <p className="text-slate-500 font-bold text-[10px] uppercase tracking-widest mt-1">Past Connections</p>
                     </div>
                   </button>
                </div>
              </div>
            </div>
          )}

          {/* 2. DISCOVERY FEED */}
          {step === 'feed' && (
            <div className={`h-full ${THEME.neutral.bg} flex flex-col pt-16 animate-in fade-in`}>
              <div className="px-8 mb-6 flex justify-between items-center">
                <h2 className="text-3xl font-black text-white italic tracking-tighter">Discovery</h2>
                <div className={`${roleTheme.light} border ${roleTheme.border} px-3 py-1.5 rounded-full`}>
                    <span className={`text-[10px] font-black ${roleTheme.text}`}>ROLE: {role.toUpperCase()}</span>
                </div>
              </div>
              
              <div className="flex-1 px-5 pb-32 relative">
                
                {/* FOUNDER SWIPE LIMIT WARNING */}
                {role === 'founder' && !swipeWarningShown && (
                  <div className="absolute inset-x-5 top-1/4 z-[100] bg-indigo-600 rounded-[35px] p-8 text-center shadow-2xl animate-in zoom-in-95">
                    <AlertCircle size={40} className="text-white mx-auto mb-4" />
                    <h3 className="text-2xl font-black text-white italic mb-2">Intentionality check.</h3>
                    <p className="text-indigo-100 mb-6 text-sm leading-relaxed">You only have <strong className="text-white font-black">5 right swipes a week</strong>. Review profiles carefully. Use them intentionally.</p>
                    <button onClick={() => setSwipeWarningShown(true)} className="w-full bg-white text-indigo-900 py-4 rounded-2xl font-black text-lg">I understand</button>
                  </div>
                )}

                <div className={`h-full relative transition-all duration-500 ease-out transform
                    ${swipeDir === 'right' ? 'translate-x-[120%] rotate-12 opacity-0' : ''}
                    ${swipeDir === 'left' ? '-translate-x-[120%] -rotate-12 opacity-0' : ''}`}
                >
                    {/* FEED CARD - STRICT TO DOCUMENT RULES */}
                    <div className={`${THEME.neutral.card} h-[600px] rounded-[40px] border ${THEME.neutral.border} overflow-hidden flex flex-col shadow-2xl relative ${role === 'founder' && !swipeWarningShown ? 'blur-md opacity-50 pointer-events-none' : ''}`}>
                        
                        <div className="p-8 flex-1 overflow-y-auto no-scrollbar">
                            {role === 'founder' ? (
                                // INVESTOR CARD (seen by Founder)
                                <>
                                  <h3 className="text-3xl font-black text-white mb-2 italic">
                                      {MOCK_DATA.investors[swipedCount]?.name}
                                  </h3>
                                  <p className="text-slate-400 font-bold mb-8">{MOCK_DATA.investors[swipedCount]?.firm}</p>
                                  
                                  <div className="space-y-6">
                                    <div>
                                      <p className="text-[10px] text-indigo-500 font-bold uppercase tracking-widest mb-1">Ticket Size</p>
                                      <p className="text-white font-medium">{MOCK_DATA.investors[swipedCount]?.ticketSize}</p>
                                    </div>
                                    <div>
                                      <p className="text-[10px] text-indigo-500 font-bold uppercase tracking-widest mb-1">Focus Areas</p>
                                      <p className="text-white font-medium">{MOCK_DATA.investors[swipedCount]?.focusAreas}</p>
                                    </div>
                                    <div>
                                      <p className="text-[10px] text-indigo-500 font-bold uppercase tracking-widest mb-1">Geography</p>
                                      <p className="text-white font-medium">{MOCK_DATA.investors[swipedCount]?.geography}</p>
                                    </div>
                                    <div className="p-4 bg-slate-900/50 rounded-2xl border border-slate-800">
                                      <p className="text-white text-sm leading-relaxed italic opacity-80">
                                          "{MOCK_DATA.investors[swipedCount]?.style}"
                                      </p>
                                    </div>
                                  </div>
                                </>
                            ) : (
                                // FOUNDER CARD (seen by Investor)
                                <>
                                  <h3 className="text-3xl font-black text-white mb-2 italic">
                                      {MOCK_DATA.founders[swipedCount]?.company}
                                  </h3>
                                  <p className="text-slate-400 font-bold mb-8">{MOCK_DATA.founders[swipedCount]?.sector}</p>
                                  
                                  <div className="space-y-6">
                                    <div>
