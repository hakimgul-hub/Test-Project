  founder: { 
    primary: 'bg-indigo-500', 
    text: 'text-indigo-400', 
    border: 'border-indigo-500/30',
    light: 'bg-indigo-500/10'
  },
  investor: { 
    primary: 'bg-emerald-500', 
    text: 'text-emerald-400', 
    border: 'border-emerald-500/30',
    light: 'bg-emerald-500/10'
  },
  neutral: {
