                                    </div>
                                    <div>
                                      <p className="text-[10px] text-emerald-500 font-bold uppercase tracking-widest mb-1">Team</p>
                                      <p className="text-white font-medium text-sm leading-relaxed">{MOCK_DATA.founders[swipedCount]?.team}</p>
                                    </div>
