                                      <p className="text-white font-medium text-sm leading-relaxed">{MOCK_DATA.founders[swipedCount]?.problem}</p>
                                    </div>
                                    <div>
                                      <p className="text-[10px] text-emerald-500 font-bold uppercase tracking-widest mb-1">Their Idea</p>
                                      <p className="text-white font-medium text-sm leading-relaxed">{MOCK_DATA.founders[swipedCount]?.idea}</p>
                                    </div>
                                    <div>
