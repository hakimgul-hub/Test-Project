                        <textarea rows="3" placeholder={q.ph} className={`${THEME.neutral.card} w-full p-4 rounded-2xl border border-slate-800 text-white font-medium outline-none focus:border-indigo-500 text-sm resize-none`} />
                      </div>
                    ))}
                </div>
                <button onClick={() => setStep('pending-intent')} className="w-full bg-indigo-500 text-white py-5 rounded-2xl font-black text-lg mt-8 shadow-xl shadow-indigo-500/20 active:scale-95 transition-all flex justify-center items-center gap-2">
                  <Send size={20} /> Submit Request
                </button>
            </div>
          )}

          {/* 6. DECISION WAITING STATE (FOUNDER) */}
          {step === 'pending-intent' && (
             <div className={`min-h-full ${THEME.neutral.bg} flex flex-col items-center justify-center p-10 text-center animate-in zoom-in-95`}>
               <div className="w-24 h-24 bg-slate-900 rounded-[35px] flex items-center justify-center mb-8 border border-slate-800">
                  <Clock size={40} className="text-slate-500" />
               </div>
               <h2 className="text-4xl font-black text-white italic tracking-tighter mb-4">Pending.</h2>
               <p className="text-slate-500 mb-12 font-medium">Request sent. No response or follow-up is required from you.</p>
               
               <button onClick={() => setStep('scheduling')} className="text-xs font-bold text-indigo-500 underline underline-offset-4 mt-10">Developer: Simulate Investor Approval</button>
             </div>
          )}

          {/* 5. INTENT REVIEW (INVESTOR ONLY) */}
          {step === 'intent-review' && (
            <div className={`min-h-full ${THEME.neutral.bg} p-8 pt-20 animate-in slide-in-from-right-10`}>
                <h2 className="text-3xl font-black text-white italic tracking-tighter mb-2">Evaluate Intent.</h2>
                <p className="text-slate-500 text-sm mb-8">Review the ask. Control your time.</p>
                
                <div className={`${THEME.neutral.card} border border-slate-800 rounded-[30px] p-6 mb-8`}>
                   <h3 className="text-xl font-black text-white mb-6">Vector Health</h3>
                   <div className="space-y-6">
                      <div>
                        <p className="text-[10px] text-emerald-500 font-bold uppercase tracking-widest mb-2">Why now?</p>
                        <p className="text-slate-300 text-sm italic">"We just secured 3 pilot clinics and need capital to scale our backend infrastructure before Q3."</p>
                      </div>
                      <div>
                        <p className="text-[10px] text-emerald-500 font-bold uppercase tracking-widest mb-2">Why you?</p>
                        <p className="text-slate-300 text-sm italic">"Your thesis on decentralizing diagnostics matches our roadmap exactly."</p>
                      </div>
                      <div>
                        <p className="text-[10px] text-emerald-500 font-bold uppercase tracking-widest mb-2">What is the ask?</p>
                        <p className="text-slate-300 text-sm italic">"Looking to close a $500k pre-seed round. We'd love 15 mins to discuss fit."</p>
                      </div>
                   </div>
                </div>

                <div className="flex gap-4">
                  <button onClick={() => completeJourney('no')} className="flex-1 bg-slate-900 text-white py-5 rounded-2xl font-black border border-slate-800 active:scale-95 transition-all">Decline</button>
                  <button onClick={() => setStep('scheduling')} className="flex-1 bg-emerald-500 text-white py-5 rounded-2xl font-black shadow-xl shadow-emerald-500/20 active:scale-95 transition-all">Approve</button>
                </div>
            </div>
          )}

          {/* 7. SCHEDULING (IF APPROVED) */}
          {step === 'scheduling' && (
             <div className={`min-h-full ${THEME.neutral.bg} p-8 pt-24 animate-in slide-in-from-bottom-10`}>
               <div className={`w-16 h-16 ${roleTheme.light} rounded-2xl flex items-center justify-center mb-6 text-white`}><CalendarDays size={28} /></div>
               <h2 className="text-4xl font-black text-white italic tracking-tighter mb-2">Lock In.</h2>
               <p className="text-slate-400 text-sm font-medium mb-10">Select a time for your bounded 15-minute Loop.</p>

               <div className="space-y-3 mb-12">
                 {['Today, 2:00 PM', 'Tomorrow, 10:30 AM', 'Thursday, 4:00 PM'].map((time, i) => (
                    <button key={i} onClick={() => { setActiveTab('calls'); setStep('calls'); }} className={`${THEME.neutral.card} w-full p-6 rounded-2xl border border-slate-800 text-left hover:border-white transition-all active:scale-95 flex justify-between items-center group`}>
                      <span className="text-white font-bold">{time}</span>
                      <ChevronRight size={20} className="text-slate-600 group-hover:text-white" />
                    </button>
                 ))}
               </div>
             </div>
          )}

          {/* LOOPS DIRECTORY */}
          {step === 'calls' && (
            <div className={`min-h-full ${THEME.neutral.bg} pt-24 px-8 flex flex-col animate-in fade-in`}>
              <h2 className="text-4xl font-black text-white italic tracking-tighter mb-8">Loops.</h2>
              
              <div className="flex-1 space-y-8 pb-32">
                {hasMatches && activeCallPartner && (
                    <div className={`${THEME.neutral.card} border ${roleTheme.border} p-8 rounded-[40px] shadow-2xl animate-in slide-in-from-bottom-4 relative overflow-hidden`}>
                        <div className={`absolute top-0 left-0 w-full h-1 ${roleTheme.primary}`} />
                        <div className="flex items-center gap-4 mb-8">
                            <div className={`w-14 h-14 ${roleTheme.light} rounded-2xl flex items-center justify-center ${roleTheme.text}`}><Phone size={24} /></div>
                            <div>
                                <p className="font-black text-xl text-white tracking-tight">{activeCallPartner.name || activeCallPartner.company}</p>
                                <p className="text-[10px] font-bold text-slate-500 uppercase tracking-widest mt-1">Confirmed: 15m Loop</p>
                            </div>
                        </div>
                        <button onClick={() => { setTimeLeft(900); setStep('active-call'); }} className="w-full py-5 bg-white text-black rounded-2xl font-black text-lg active:scale-95 transition-all shadow-lg flex items-center justify-center gap-3">
                            <Video size={20} /> Join Call
                        </button>
                    </div>
                )}

                <div className="pt-4 border-t border-slate-900">
                    <p className="text-[10px] font-black text-slate-500 uppercase tracking-[0.3em] mb-6 flex items-center gap-2">
                        <HistoryIcon size={12} /> Closed Matches History
                    </p>
                    {callHistory.length > 0 ? (
                        <div className="space-y-3">
                            {callHistory.map(entry => (
                                <div key={entry.id} className={`${THEME.neutral.card} border border-slate-900 p-5 rounded-3xl flex justify-between items-center group`}>
                                    <div>
                                        <p className="font-bold text-white tracking-tight italic">{entry.partner}</p>
                                        <p className="text-[10px] text-slate-500 font-bold uppercase tracking-widest">{entry.date}</p>
                                    </div>
                                    <div className={`px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest ${entry.outcome.includes('Off-Platform') ? 'bg-emerald-500/10 text-emerald-400' : 'bg-slate-800 text-slate-500'}`}>
                                        {entry.outcome}
                                    </div>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <div className="h-32 flex items-center justify-center border-2 border-dashed border-slate-900 rounded-[30px] opacity-20">
                            <span className="text-xs font-bold text-slate-500 uppercase tracking-widest">No previous Loops</span>
                        </div>
                    )}
                </div>
              </div>
            </div>
          )}

          {/* 8. THE CALL */}
          {step === 'active-call' && (
            <div className="absolute inset-0 bg-[#0A0C10] z-[200] flex flex-col animate-in zoom-in-95">
                <div className="flex-1 flex flex-col items-center justify-center p-12 text-center">
                    <div className="relative mb-12">
                        <div className="w-40 h-40 bg-slate-900 rounded-[60px] flex items-center justify-center overflow-hidden border border-slate-800">
                             <User size={80} className="text-slate-800" />
                        </div>
                        <div className="absolute -bottom-4 left-1/2 -translate-x-1/2 bg-red-500 px-4 py-1.5 rounded-full text-white text-[10px] font-black uppercase tracking-widest animate-pulse shadow-lg shadow-red-500/50 border-[4px] border-[#0A0C10]">
                            Live
                        </div>
                    </div>
                    
                    <h3 className="text-4xl font-black text-white italic tracking-tighter mb-2">{activeCallPartner?.name || activeCallPartner?.company}</h3>
                    <p className="text-slate-500 font-bold uppercase tracking-[0.3em] text-[10px] mb-8">FOUND LOOP • 15 MIN BOUNDED</p>
                    
                    <div className="text-7xl font-black text-white font-mono tracking-tighter drop-shadow-2xl">
                        {formatTime(timeLeft)}
                    </div>
                    <p className="text-slate-600 font-bold uppercase tracking-widest text-[9px] mt-3">Remaining in Loop</p>
                </div>

                <div className="p-12 pb-20 flex justify-center gap-6">
                    <button className="w-20 h-20 rounded-full bg-slate-900 text-white flex items-center justify-center border border-slate-800 active:scale-90 transition-all"><Mic size={24} /></button>
                    <button onClick={() => setStep('post-call-survey')} className="w-24 h-24 rounded-[35px] bg-red-600 text-white flex items-center justify-center shadow-2xl shadow-red-500/20 active:scale-90 transition-all"><PhoneOff size={32} /></button>
                    <button className="w-20 h-20 rounded-full bg-slate-900 text-white flex items-center justify-center border border-slate-800 active:scale-90 transition-all"><Video size={24} /></button>
                </div>
            </div>
          )}

          {/* 9. OUTCOME */}
          {step === 'post-call-survey' && (
            <div className={`absolute inset-0 ${THEME.neutral.bg} z-[210] p-10 flex flex-col justify-center text-center animate-in slide-in-from-bottom-full duration-500`}>
                <div className="w-24 h-24 bg-slate-900 rounded-[40px] flex items-center justify-center mx-auto mb-8 border border-slate-800"><CheckCircle2 size={40} className="text-white" /></div>
                <h2 className="text-5xl font-black text-white italic tracking-tighter mb-4">Loop Complete.</h2>
                <p className="text-slate-400 font-medium mb-16 text-lg">Continue off-platform?</p>
                
                <div className="space-y-4">
                    <button onClick={() => completeJourney('yes')} className={`w-full p-6 ${roleTheme.primary} rounded-3xl text-white font-black text-xl active:scale-95 transition-all shadow-xl`}>
                        Yes
                    </button>
                    <button onClick={() => completeJourney('no')} className="w-full p-6 bg-slate-900 border border-slate-800 rounded-3xl text-white font-black text-xl active:scale-95 transition-all">
                        No
                    </button>
                </div>
            </div>
          )}

          {/* PROFILE */}
          {step === 'profile' && (
             <div className={`min-h-full ${THEME.neutral.bg} pt-24 px-8 animate-in fade-in`}>
                <div className="flex flex-col items-center mb-12">
                  <div className={`w-24 h-24 ${roleTheme.primary} rounded-[35px] flex items-center justify-center text-white text-4xl font-black italic shadow-2xl mb-6`}>
                    {role === 'founder' ? 'J' : 'A'}
                  </div>
                  <h3 className="text-2xl font-black text-white italic tracking-tighter">
                    {role === 'founder' ? 'James Kim' : 'Alex Rivers'}
                  </h3>
                  <p className="text-slate-500 font-bold uppercase tracking-widest text-[10px] mt-1">
                    {role === 'founder' ? 'Founder @ Vector Health' : 'Investor @ Blue Chip'}
                  </p>
                </div>
                <div className="space-y-3">
                  <button onClick={() => { setActiveTab('calls'); setStep('calls'); }} className={`${THEME.neutral.card} w-full flex items-center justify-between p-6 rounded-2xl border border-slate-800`}>
                    <span className="font-bold text-white">View Loop History</span>
                    <HistoryIcon size={18} className="text-slate-500" />
                  </button>
                  <button onClick={() => { setStep('landing'); setRole(null); }} className="w-full p-6 bg-slate-900 border border-slate-800 rounded-2xl text-red-500 font-bold text-left mt-4">Sign Out</button>
                </div>
             </div>
          )}

        </main>

        {/* BOTTOM NAVIGATION */}
        {['home', 'feed', 'calls', 'profile'].includes(step) && <Navbar />}
      </div>
    </div>
  );
}
