    { 
      id: 'i1', name: 'Alex Rivers', firm: 'Blue Chip Ventures', 
      ticketSize: '$500K - $1.5M', focusAreas: 'Infrastructure, DevTools', 
      geography: 'San Francisco / Remote', 
      style: 'Ex-Stripe. I back technical founders building the unsexy plumbing of the internet.'
    },
    { 
      id: 'i2', name: 'Sarah Chen', firm: 'Nexus Labs', 
      ticketSize: '$250K - $750K', focusAreas: 'HealthTech, Applied AI', 
      geography: 'London, UK', 
      style: 'Medical doctor turned builder. Passionate about decentralizing diagnostics.'
    }
  ],
  founders: [
    { 
      id: 'f1', company: 'Vector Health', name: 'James Kim', 
      sector: 'Health AI', 
      problem: 'Administrative overhead consumes 40% of a clinician’s time.',
      idea: 'Real-time ambient voice to structured medical records.',
      proof: 'Piloted in 3 clinics, saving 2 hours per doctor daily.',
      team: '2x 2nd time founders, ML PhD from Stanford.'
    }
  ]
};

export default function App() {
  // Navigation & Flow State
  const [step, setStep] = useState('landing'); // landing, auth, role-selection, setup, pending-verification, feed, match, intent-form, intent-review, pending-intent, scheduling, calls, active-call, post-call-survey
  const [role, setRole] = useState(null);
  const [activeTab, setActiveTab] = useState('discovery');
  
  // Interaction State
  const [swipedCount, setSwipedCount] = useState(0);
  const [swipeDir, setSwipeDir] = useState(null);
  const [hasMatches, setHasMatches] = useState(false);
  const [callHistory, setCallHistory] = useState([]);
  const [activeCallPartner, setActiveCallPartner] = useState(null);
  const [swipeWarningShown, setSwipeWarningShown] = useState(false);
  
  // Time & Form State
  const [timeLeft, setTimeLeft] = useState(900); // 15 minutes
  const [toastMsg, setToastMsg] = useState(null);

  const roleTheme = useMemo(() => (role ? THEME[role] : THEME.founder), [role]);

  // Timer logic for Active Call
  useEffect(() => {
    let timer;
    if (step === 'active-call' && timeLeft > 0) {
      timer = setInterval(() => setTimeLeft(prev => prev - 1), 1000);
    } else if (step === 'active-call' && timeLeft === 0) {
      setStep('post-call-survey');
    }
    return () => clearInterval(timer);
  }, [step, timeLeft]);

  const formatTime = (seconds) => {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  };

  const showToast = (msg) => {
    setToastMsg(msg);
    setTimeout(() => setToastMsg(null), 2500);
  };

  const handleSwipe = (dir) => {
    if (role === 'founder' && !swipeWarningShown) {
      setSwipeWarningShown(true);
      return; // Stop swipe to show warning first
    }

    setSwipeDir(dir);
    const items = role === 'founder' ? MOCK_DATA.investors : MOCK_DATA.founders;
    const currentItem = items[swipedCount];

    setTimeout(() => {
      if (dir === 'right') {
        showToast("Interest saved privately.");
        // Simulate immediate match for demo flow
        setTimeout(() => {
          setHasMatches(true);
          setActiveCallPartner(currentItem);
          setStep('match');
        }, 1000);
      } else {
        setSwipedCount(prev => prev + 1);
      }
      setSwipeDir(null);
    }, 450);
  };

  const completeJourney = (outcome) => {
    const newEntry = {
      id: Date.now(),
      partner: activeCallPartner.name || activeCallPartner.company,
      date: new Date().toLocaleDateString(),
      outcome: outcome === 'yes' ? 'Moved Off-Platform' : 'Closed',
      role: role
    };
    setCallHistory([newEntry, ...callHistory]);
    setHasMatches(false);
    setActiveTab('home');
    setStep('home');
  };

  // --- UI Components ---

  const Navbar = () => {
    const tabs = [
      { id: 'home', label: 'Home', icon: Home, route: 'home' },
      { id: 'discovery', label: 'Discover', icon: Compass, route: 'feed' },
      { id: 'calls', label: 'Loops', icon: Activity, route: 'calls' },
      { id: 'profile', label: 'Account', icon: UserCircle, route: 'profile' },
    ];

    return (
      <nav className="absolute bottom-10 left-1/2 -translate-x-1/2 w-[90%] z-50">
        <div className={`${THEME.neutral.card} backdrop-blur-xl border ${THEME.neutral.border} rounded-full px-2 py-2 flex justify-between shadow-2xl shadow-black/50`}>
          {tabs.map((tab) => {
            const isActive = activeTab === tab.id;
            const Icon = tab.icon;
            return (
              <button
                key={tab.id}
                onClick={() => { setActiveTab(tab.id); setStep(tab.route); }}
                className={`relative flex-1 py-3 flex flex-col items-center gap-1 transition-all rounded-full ${isActive ? 'text-white' : 'text-slate-500'}`}
              >
                {isActive && <div className={`absolute inset-0 ${roleTheme.light} rounded-full animate-in fade-in zoom-in-95`} />}
                <Icon size={isActive ? 20 : 22} strokeWidth={isActive ? 2.5 : 2} className="relative z-10" />
                <span className="text-[9px] font-bold uppercase tracking-widest relative z-10">{tab.label}</span>
              </button>
            );
          })}
        </div>
      </nav>
    );
  };

  return (
    <div className="h-screen w-full flex items-center justify-center bg-slate-950 font-sans">
      <div className="w-full max-w-[430px] h-full sm:h-[880px] bg-black sm:rounded-[60px] relative overflow-hidden shadow-[0_0_0_10px_#111,0_60px_100px_-20px_rgba(0,0,0,1)] border-[8px] border-[#1f1f1f]">
        <div className="hidden sm:block absolute top-0 left-1/2 -translate-x-1/2 w-32 h-7 bg-black rounded-b-2xl z-50" />
        
        {/* TOAST NOTIFICATION */}
        {toastMsg && (
          <div className="absolute top-14 left-1/2 -translate-x-1/2 z-[300] bg-slate-800 text-white px-5 py-3 rounded-full text-sm font-bold shadow-xl animate-in fade-in slide-in-from-top-5">
            {toastMsg}
          </div>
        )}

        <main className="h-full overflow-y-auto no-scrollbar pb-32">
          
          {/* 0. LANDING & AUTH */}
          {step === 'landing' && (
             <div className={`h-full ${THEME.neutral.bg} flex flex-col items-center justify-center p-10 animate-in fade-in`}>
